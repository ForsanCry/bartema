#!/usr/bin/env bash
# bartema - switch the Noctalia v5 bar between transparent and flat
CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/noctalia"
OVERRIDE="$CONF_DIR/zz-bartema.toml"
BAR="${BARTEMA_BAR:-default}"
OPACITY="${BARTEMA_OPACITY:-0.3}"
RADIUS="${BARTEMA_RADIUS:-18}"

restart() {
  pkill -x noctalia
  for _ in $(seq 1 20); do pgrep -x noctalia >/dev/null || break; sleep 0.2; done
  setsid noctalia >/dev/null 2>&1 &
}

case "${1:-}" in
  transparent)
    gap="${2:-4}"
    [[ "$gap" =~ ^[0-9]+([.][0-9]+)?$ ]] || { echo "gap must be a number, e.g. bartema transparent 2"; exit 1; }
    mkdir -p "$CONF_DIR"
    {
      echo "# generated by bartema"
      echo "[bar.$BAR]"
      echo "background_opacity = $OPACITY"
      echo "concave_edge_corners = false"
      echo "margin_edge = $gap"
      echo "margin_ends = 40"
      echo "radius_top_left = $RADIUS"
      echo "radius_top_right = $RADIUS"
      echo "radius_bottom_left = $RADIUS"
      echo "radius_bottom_right = $RADIUS"
    } > "$OVERRIDE"
    if ! noctalia config validate >/dev/null 2>&1; then
      rm -f "$OVERRIDE"
      echo "invalid config, change reverted"
      exit 1
    fi
    ;;
  flat)
    rm -f "$OVERRIDE"
    ;;
  *)
    echo "usage: bartema transparent [gap] | bartema flat"
    exit 1
    ;;
esac
restart
